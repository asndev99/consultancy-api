generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id Int @id @default(autoincrement())

  businessCode    String @unique
  studentSequence Int    @default(0)
  timeZone        String @default("Asia/Karachi")

  name         String  @unique
  isActive     Boolean @default(true)
  isDeleted    Boolean @default(false)
  address      String
  businessLogo String

  googleMapUrl String @default("")

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt           DateTime             @default(now()) @db.Timestamptz()
  updatedAt           DateTime             @updatedAt @db.Timestamptz()
  deletedAt           DateTime?            @db.Timestamptz()
  users               User[]
  studentApplications StudentApplication[]
  universities        University[]
  universityCourses   UniversityCourses[]
  UserBranches        UserBranch[]
  students            Student[]
  branches            Branch[]
  leadForms           LeadForms[]
}

model Branch {
  id Int @id @default(autoincrement())

  name String @unique

  branchCode String @unique

  timeZone String @default("Asia/Karachi")

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  city    String
  country String

  //location perspective.
  address   String
  latitude  Float?
  longitude Float?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt           DateTime             @default(now()) @db.Timestamptz()
  updatedAt           DateTime             @updatedAt @db.Timestamptz()
  deletedAt           DateTime?            @db.Timestamptz()
  branchUsers         UserBranch[]
  users               User[]
  studentApplications StudentApplication[]
  students            Student[]
  leadForms           LeadForms[]
}

model User {
  id Int @id @default(autoincrement())

  userNo String @unique //just as employee no.

  role         String //roles defined in shared/application.constants.js
  status       String //status defined in shared/application.constants.js
  inviteSentAt DateTime? @db.Timestamptz()

  // Personal details
  name                 String
  email                String
  password             String?
  phoneNumber          String?
  profileMedia         String?
  previousEmailAddress String? //in update form if we allow admin updating email address, so just to keep track.

  businessId Int? // Nullable for application admin
  Business   Business? @relation(fields: [businessId], references: [id])

  branchId Int? // Nullable for application admin and owner
  Branch   Branch? @relation(fields: [branchId], references: [id])

  backUpEmailAddress String?

  isEmailVerified Boolean @default(false)
  isActive        Boolean @default(true)
  isDeleted       Boolean @default(false)

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  inviteAcceptedAt DateTime? @db.Timestamptz()
  createdAt        DateTime  @default(now()) @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @db.Timestamptz()
  deletedAt        DateTime? @db.Timestamptz()

  userBranches UserBranch[]

  managedApplications       StudentApplication[]        @relation("ApplicationManager")
  officerApplications       StudentApplication[]        @relation("AdmissionTeamOfficer")
  // studentApplications StudentApplication[] @relation("Counselor")
  // sessions            Sessions[]
  students                  Student[]
  studentApplicationRemarks StudentApplicationRemarks[]

  @@unique([businessId, email])
}

//Because one branch can have many managers in future.
//Because one counselor can be assigned to many branches.
//for now a user with a particular role can exist at multiple branches 
//but a user with different role cannot exists at multiple branches
model UserBranch {
  id Int @id @default(autoincrement())

  isActive Boolean @default(false)
  branchId Int
  Branch   Branch  @relation(fields: [branchId], references: [id])

  userId Int
  User   User @relation(fields: [userId], references: [id])

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  @@unique([userId, branchId])
}

enum LeadStage {
  NewLead
  DocumentSubmitted
  ApplicationSubmitted
  VisaProcessing
  Enrolled
}

//lead //need to add marketing source in future.
model Student {
  id Int @id @default(autoincrement())

  studentNo String @unique

  fullName String
  email    String
  phoneNo  String

  preferredTargetCountries String[]  @default([])
  targetDegree             String?
  leadStage                LeadStage @default(NewLead)

  leadSource     String?
  isFromLeadForm Boolean    @default(false)
  leadFormId     Int?
  LeadForm       LeadForms? @relation(fields: [leadFormId], references: [id])

  status String?

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  branchId Int
  Branch   Branch @relation(fields: [branchId], references: [id])

  counselorId Int?
  Counselor   User? @relation(fields: [counselorId], references: [id])

  previousBranch       String?
  studentTransferredAt DateTime?

  isActive  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  studentApplications   StudentApplication[]
  targetUniversities    TargetUniversity[]
  documentTitles        DocumentTitle[]
  studentDocumentMedias StudentDocumentMedia[]

  @@unique([businessId, branchId, email, phoneNo])
}

model DocumentTitle {
  id            Int     @id @default(autoincrement())
  studentId     Int
  Student       Student @relation(fields: [studentId], references: [id])
  documentTitle String
  isMandatory   Boolean
  quantity      Int?

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt             DateTime               @default(now()) @db.Timestamptz()
  updatedAt             DateTime               @updatedAt @db.Timestamptz()
  deletedAt             DateTime?              @db.Timestamptz()
  studentDocumentMedias StudentDocumentMedia[]
}

model StudentDocumentMedia {
  id Int @id @default(autoincrement())

  studentId  Int
  Student    Student       @relation(fields: [studentId], references: [id])
  documentId Int
  Document   DocumentTitle @relation(fields: [documentId], references: [id])

  mediaType String
  fileKey   String
  isActive  Boolean @default(false)
  isDeleted Boolean @default(false)
  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model TargetUniversity {
  id Int @id @default(autoincrement())

  studentId Int
  Student   Student @relation(fields: [studentId], references: [id])

  universityId Int
  University   University @relation(fields: [universityId], references: [id])

  isActive  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt     DateTime       @default(now()) @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @db.Timestamptz()
  deletedAt     DateTime?      @db.Timestamptz()
  targetCourses TargetCourse[]

  @@unique([studentId, universityId])
}

model TargetCourse {
  id                 Int              @id @default(autoincrement())
  targetUniversityId Int
  TargetUniversity   TargetUniversity @relation(fields: [targetUniversityId], references: [id], onDelete: Cascade)

  courseId  Int
  Course    UniversityCourses @relation(fields: [courseId], references: [id])
  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  @@unique([targetUniversityId, courseId])
}

//one student can have many application.
model StudentApplication {
  id Int @id @default(autoincrement())

  //prefix will be business-shortcode-branch-shortcode.
  applicationId Int @unique // For tracking just like ticketing system

  // Application admission related fields
  applicationStatus           String
  applicationIntake           String
  applicationTargetUniversity String
  applicationTargetCourses    String[]
  applicationTutionFee        Float
  tutionFeeCurrency           String

  applicationSubmittedAt DateTime? @db.Timestamptz()

  isAdmissionTeamAssigned Boolean @default(false)
  isManagerAssigned       Boolean @default(false)

  managerAssignedAt       DateTime? @db.Timestamptz()
  admissionTeamAssignedAt DateTime? @db.Timestamptz()

  isActive Boolean @default(true)

  studentId Int
  Student   Student @relation(fields: [studentId], references: [id])

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  branchId Int?
  Branch   Branch? @relation(fields: [branchId], references: [id])

  managerId Int?
  Manager   User? @relation("ApplicationManager", fields: [managerId], references: [id])

  // counselorId Int?
  // Counselor   User? @relation("Counselor", fields: [counselorId], references: [id])

  admissionOfficerId Int?
  AdmissionOfficer   User? @relation("AdmissionTeamOfficer", fields: [admissionOfficerId], references: [id])

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  studentApplicationTeams   StudentApplicationTeam[]
  studentApplicationRemarks StudentApplicationRemarks[]
}

//just to keep the track record of who was previously assigned and who is currently assigned.
//the ids are tracked in above table of currently assinged officers.
model StudentApplicationTeam {
  id Int @id @default(autoincrement())

  applicationId Int
  Application   StudentApplication @relation(fields: [applicationId], references: [id])

  designation String //branch manager or admission team officer // or counselors.
  memberName  String

  isActive  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  //refers to assigned At.
  // FIX: added @default(now()) and @db.Timestamptz() for consistency
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model StudentApplicationRemarks {
  id Int @id @default(autoincrement())

  comment       String?
  applicationId Int
  Application   StudentApplication @relation(fields: [applicationId], references: [id])

  authorId  Int
  Author    User @relation(fields: [authorId], references: [id])
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

enum UniversityType {
  Public
  Private
}

model University {
  id Int @id @default(autoincrement())

  isFromSystem   Boolean        @default(false)
  universityName String
  country        String
  link           String
  type           UniversityType @default(Public)

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  isDeleted Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  universityRequirements UniversityRequirement[]
  universityCourses      UniversityCourses[]
  targetUniversities     TargetUniversity[]
}

model UniversityRequirement {
  id           Int        @id @default(autoincrement())
  universityId Int
  University   University @relation(fields: [universityId], references: [id])

  title   String
  details String

  sortOrder Int @default(0)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)
  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

model UniversityCourses {
  id Int @id @default(autoincrement())

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  universityId Int
  University   University @relation(fields: [universityId], references: [id])

  isActive           Boolean @default(false)
  courseRequirements String?

  courseTitle       String
  degreeLevel       String
  tutionFeeCurrency String?
  tutionPeriod      String?
  tutionFee         Float

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt             DateTime               @default(now()) @db.Timestamptz()
  updatedAt             DateTime               @updatedAt @db.Timestamptz()
  deletedAt             DateTime?              @db.Timestamptz()
  universityIntakeDates UniversityIntakeDate[]
  targetCourses         TargetCourse[]
}

model UniversityIntakeDate {
  id Int @id @default(autoincrement())

  isActive Boolean @default(true)

  date DateTime @db.Date

  courseId Int
  Course   UniversityCourses @relation(fields: [courseId], references: [id])

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt    DateTime  @default(now()) @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @db.Timestamptz()
  deletedAt    DateTime? @db.Timestamptz()
  universityId Int?
}

enum LeadFormType {
  ORG_LEVEL
  BRANCH_LEVEL
}

model LeadForms {
  id        Int     @id @default(autoincrement())
  publicId  String  @unique @default(cuid()) // used in shareable URL: ?formId=xxx
  name      String // "UK Universities 2026 Intake"
  utmSource String? // "Facebook Ads"

  type LeadFormType

  businessId Int
  Business   Business @relation(fields: [businessId], references: [id])

  branchId Int?
  Branch   Branch? @relation(fields: [branchId], references: [id])

  targetDegreeLevel String
  targetCountries   String[]
  totalSubmissions  Int      @default(0)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdBy Int
  updatedBy Int?
  deletedBy Int?

  createdAt       DateTime          @default(now()) @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @db.Timestamptz()
  deletedAt       DateTime?         @db.Timestamptz()
  leadSubmissions LeadSubmissions[]
  students        Student[]
}

//lead will go into this form when lead form type is ORG_LEVEL
//if lead type is BRANCH_LEVEL then the lead submission will go into student and student
model LeadSubmissions {
  id     Int       @id @default(autoincrement())
  formId Int
  Form   LeadForms @relation(fields: [formId], references: [id])

  //fields needed to make student.
  fullName String
  email    String
  phoneNo  String

  preferredTargetCountries String[] @default([])
  targetDegreeLevel        String?
  additionalNotes          String?

  leadSource String? // copied from LeadForm.utmSource at submit time

  syncStatus   Boolean @default(false)
  failedReason String?

  isTransferred         Boolean @default(false)
  transferredBranchName String?

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()
}

